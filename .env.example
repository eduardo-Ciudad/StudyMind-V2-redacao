# Copie para .env (que o git ignora) e preencha. Nunca commite o .env.

# Banco (o compose cria o banco e o usuário com estes valores na primeira subida)
DB_NAME=studymind_redacao
DB_USERNAME=studymind
DB_PASSWORD=troque-por-uma-senha-forte

# JWT: pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=120

# Gemini
GEMINI_API_KEY=sua-chave-do-gemini

# URL do frontend que pode chamar a API (várias separadas por vírgula)
CORS_ORIGENS=http://localhost:5173

# Cadastro: fechado por padrão; só os e-mails da lista criam conta
CADASTRO_ABERTO=false
CADASTRO_EMAILS_PERMITIDOS=

# Limites de correção
LIMITE_CORRECOES_DIARIAS=3
LIMITE_CORRECOES_GLOBAL=30

# Use native quando houver proxy/HTTPS (Nginx, Caddy, Traefik) na frente da API
FORWARD_HEADERS=none
