{
  "info": {
    "_postman_id": "9d7f79cf-0eb9-4ace-9b5e-4d77a02b60a3",
    "name": "StudyMind Redação — Auth",
    "description": "Testes da Etapa 2 (Spring Security + JWT).\n\nRode a collection inteira pelo Runner, na ordem: o cadastro gera um e-mail único, o login salva o token e as chamadas seguintes usam essas variáveis.\n\nAjuste `baseUrl` se a API não estiver em http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Cadastro",
      "item": [
        {
          "name": "Cadastro - sucesso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Teste\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// E-mail único a cada execução para o fluxo poder rodar várias vezes",
                  "const email = `aluno.${Date.now()}@teste.com`;",
                  "pm.collectionVariables.set(\"email\", email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Retorna usuário sem senha\", () => {",
                  "    pm.expect(body.id).to.be.a(\"string\");",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "    pm.expect(body.role).to.eql(\"ALUNO\");",
                  "    pm.expect(body).to.not.have.property(\"senha\");",
                  "    pm.expect(body).to.not.have.property(\"senhaHash\");",
                  "});",
                  "pm.collectionVariables.set(\"usuarioId\", body.id);"
                ]
              }
            }
          ]
        },
