    {
      "name": "3. Rotas protegidas",
      "item": [
        {
          "name": "Me - com token (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Dados vêm do token\", () => {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get(\"usuarioId\"));",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "    pm.expect(body.role).to.eql(\"ALUNO\");",
                  "});"
                ]
              }
            }
          ]
        },
