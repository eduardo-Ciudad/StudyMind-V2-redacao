                ]
              }
            }
          ]
        },
        {
          "name": "Me - token adulterado (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdulterado}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Troca o último caractere da assinatura: o payload continua válido, mas a assinatura não",
                  "const t = pm.collectionVariables.get(\"token\");",
                  "const ultimo = t.slice(-1) === \"A\" ? \"B\" : \"A\";",
                  "pm.collectionVariables.set(\"tokenAdulterado\", t.slice(0, -1) + ultimo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
