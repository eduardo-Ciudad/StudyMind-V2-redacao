{
  "info": {
    "_postman_id": "0983c7a4-a2b1-4e62-bccd-3cef0bb615fe",
    "name": "StudyMind Redação — Evolução",
    "description": "Evolução do aluno (Passo 13).\n\nRode pelo Runner, na ordem. O setup cria um aluno novo, então a primeira chamada mostra a evolução vazia.\n\nPara ver dados de verdade, chame 'Evolução com token próprio' trocando a variável tokenProprio pelo token de uma conta que já tem redações corrigidas (pegue no localStorage do front ou no login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "senha",
      "value": "senhaSegura123"
    },
    {
      "key": "tokenProprio",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Cadastro aluno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Evolução\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `aluno.evolucao.${Date.now()}@teste.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login aluno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Evolução",
      "item": [
        {
          "name": "Evolução de aluno novo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me/evolucao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me",
                "evolucao"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Evolução vazia\", () => {",
                  "  pm.expect(body.totalCorrigidas).to.eql(0);",
                  "  pm.expect(body.melhorNota).to.eql(null);",
                  "  pm.expect(body.mediaRecente).to.eql(null);",
                  "  pm.expect(body.competenciaFoco).to.eql(null);",
                  "  pm.expect(body.serie).to.eql([]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Evolução com token próprio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me/evolucao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me",
                "evolucao"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenProprio}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Série em ordem cronológica\", () => {",
                  "  const datas = body.serie.map(p => Date.parse(p.enviadaEm));",
                  "  pm.expect(datas).to.eql([...datas].sort((a, b) => a - b));",
                  "});",
                  "pm.test(\"Total da média é a soma das competências\", () => {",
                  "  if (!body.mediaRecente) return;",
                  "  const m = body.mediaRecente;",
                  "  pm.expect(m.total).to.eql(m.c1 + m.c2 + m.c3 + m.c4 + m.c5);",
                  "});",
                  "pm.test(\"Anuladas sem notas por competência\", () => {",
                  "  body.serie.filter(p => p.anulada).forEach(p => pm.expect(p.notas).to.eql(null));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sem token responde 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me/evolucao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me",
                "evolucao"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}