{
  "info": {
    "_postman_id": "b7d00369-c83e-459f-9cd7-7e56e3d69283",
    "name": "StudyMind Redação — Temas possíveis",
    "description": "Temas possíveis do ENEM 2026 (Passo 14).\n\nRode pelo Runner, na ordem. O setup cria um aluno novo; a collection adiciona o primeiro tema possível, confere /temas, remove e confere de novo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "senha",
      "value": "senhaSegura123"
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Cadastro aluno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Temas\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `aluno.temas.${Date.now()}@teste.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login aluno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Temas possíveis",
      "item": [
        {
          "name": "Temas possíveis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"12 temas possíveis\", () => pm.expect(body.length).to.eql(12));",
                  "pm.test(\"Nenhum adicionado para aluno novo\", () => pm.expect(body.every(t => t.adicionado === false)).to.be.true);",
                  "pm.test(\"Sem índice numérico na resposta\", () => pm.expect(body[0]).to.not.have.property(\"indice\"));",
                  "pm.test(\"Material de estudo presente\", () => { pm.expect(body[0].argumentos).to.be.an(\"array\").that.is.not.empty; pm.expect(body[0].forca).to.eql(\"MUITO_FORTE\"); });",
                  "pm.collectionVariables.set(\"temaPossivelId\", body[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/temas/possiveis",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "temas",
                "possiveis"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Lista de temas ainda sem o possível",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Nenhum tema PREVISAO\", () => pm.expect(pm.response.json().some(t => t.origem === \"PREVISAO\")).to.be.false);",
                  "pm.collectionVariables.set(\"temaOficialId\", pm.response.json().find(t => t.origem === \"ENEM_OFICIAL\").id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/temas",
              "host": [
