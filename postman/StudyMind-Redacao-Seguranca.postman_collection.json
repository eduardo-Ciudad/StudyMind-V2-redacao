    {
      "name": "6ª tentativa no mesmo e-mail responde 429",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 429\", () => pm.response.to.have.status(429));",
              "pm.test(\"Tem Retry-After\", () => pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.above(0));",
              "pm.collectionVariables.unset(\"emailAlvo\");"
            ]
          }
        }
